{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/toniher/FA-nf/master/nextflow_schema.json",
  "title": "FA-nf pipeline parameters",
  "description": "Pipeline for FA analysis",
  "type": "object",
  "definitions": {
    "input_output_options": {
      "title": "Input/output options",
      "type": "object",
      "fa_icon": "fas fa-terminal",
      "description": "Define where the pipeline should find input data and save output data.",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address for completion summary.",
          "fa_icon": "fas fa-envelope",
          "help_text": "Set this parameter to your e-mail address to get a summary e-mail with details of the run sent to you when the workflow exits. If set in your user config file (`~/.nextflow/config`) then you don't need to specify this on the command line for every run.",
          "pattern": "^([a-zA-Z0-9_\\-\\.]+)@([a-zA-Z0-9_\\-\\.]+)\\.([a-zA-Z]{2,5})$"
        }
      }
    },
    "generic_options": {
      "title": "Generic options",
      "type": "object",
      "fa_icon": "fas fa-file-import",
      "description": "Less common options for the pipeline, typically set in a config file.",
      "help_text": "These options are common to all nf-core pipelines and allow you to customise some of the core preferences for how the pipeline runs.\n\nTypically these options would be set in a Nextflow config file loaded for all pipeline runs, such as `~/.nextflow/config`.",
      "properties": {
        "help": {
          "type": "boolean",
          "description": "Display help text.",
          "fa_icon": "fas fa-question-circle",
          "hidden": true
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/input_output_options"
    },
    {
      "$ref": "#/definitions/generic_options"
    }
  ],
  "properties": {
    "proteinFile": {
      "type": "string"
    },
    "gffFile": {
      "type": "string"
    },
    "debug": {
      "type": "string"
    },
    "gffclean": {
      "type": "string"
    },
    "gffstats": {
      "type": "string"
    },
    "chunkSize": {
      "type": "integer",
      "default": 25
    },
    "chunkBlastSize": {
      "type": "string"
    },
    "chunkIPSSize": {
      "type": "string"
    },
    "chunkKoalaSize": {
      "type": "string"
    },
    "chunkWebSize": {
      "type": "string"
    },
    "debugSize": {
      "type": "string"
    },
    "evalue": {
      "type": "string"
    },
    "diamond": {
      "type": "string"
    },
    "dbPath": {
      "type": "string"
    },
    "gogourl": {
      "type": "string"
    },
    "blastAnnotMode": {
      "type": "string"
    },
    "speciesName": {
      "type": "string"
    },
    "iprscanVersion": {
      "type": "string",
      "default": "5.54-87.0"
    },
    "ipscantmp": {
      "type": "string"
    },
    "kegg_species": {
      "type": "string"
    },
    "koVersion": {
      "type": "string",
      "default": "2021-05-02"
    },
    "dbEngine": {
      "type": "string"
    },
    "dbname": {
      "type": "string"
    },
    "resultPath": {
      "type": "string"
    },
    "stdoutLog": {
      "type": "string"
    },
    "stderrLog": {
      "type": "string"
    },
    "loglevel": {
      "type": "string",
      "default": "info"
    },
    "skip_cdSearch": {
      "type": "string"
    },
    "skip_sigtarp": {
      "type": "string"
    },
    "mysqllog": {
      "type": "string"
    },
    "blastFile": {
      "type": "string"
    },
    "blastDbPath": {
      "type": "string"
    },
    "gogohits": {
      "type": "string"
    },
    "kolist": {
      "type": "string"
    },
    "koprofiles": {
      "type": "string"
    },
    "koentries": {
      "type": "string"
    },
    "kegg_release": {
      "type": "string"
    },
    "keggFile": {
      "type": "string"
    },
    "ipscanproperties": {
      "type": "string"
    },
    "ipscandata": {
      "type": "string"
    },
    "rmversion": {
      "type": "string"
    },
    "oboFile": {
      "type": "string"
    },
    "blastDbFolder": {
      "type": "string"
    },
    "dbipscanPath": {
      "type": "string"
    },
    "dbKOPath": {
      "type": "string"
    }
  }
}
