// Uncomment or modify the parameters below to fit your dataset and setup choices
params {
  // Root path for Database
  dbPath = "/nfs/db"
  // Interproscan version used
  iprscanVersion = "5.52-86.0"
  // Kofam version used
  koVersion = "2021-05-02"
  // NCBI DB list - Comma separated
  blastDBList = "swissprot,pdbaa"
  // OBO url
  goOboURL = "http://www.geneontology.org/ontology/gene_ontology.obo"
}
